# Social Media Automation Platform - Environment Configuration

# AI Content Generation
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Voiceover TTS API (Optional external engine like ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# X (Twitter) Developer API
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Meta Graph API (Instagram & Facebook)
META_GRAPH_TOKEN=your_meta_graph_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
FACEBOOK_PAGE_ID=your_facebook_page_id

# Firebase Cloud DB & Auth Integration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DB_URL=https://nexus-viral-automation-default-rtdb.firebaseio.com

# Application Settings
PORT=8000
SANDBOX_MODE=true
